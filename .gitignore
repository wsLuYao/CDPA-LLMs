# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Runtime data (may contain prompts, provider responses, or account data)
auth/
data/
backups/
projects/*
!projects/.gitkeep
results/*
!results/.gitkeep
human_reference/*
!human_reference/.gitkeep
!human_reference/README.md
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/

# Frontend tooling (the shipped UI itself has no build step)
node_modules/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

# Generated archives
*.zip
*.tar.gz
