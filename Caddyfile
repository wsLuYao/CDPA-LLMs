{
	email {$ACME_EMAIL}
	admin off
}

{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 80MB
	}

	reverse_proxy app:8765 {
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow"
	}

	log {
		output stdout
		format console
	}
}
